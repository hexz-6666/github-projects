# 本地环境变量示例；不包含真实秘密，禁止提交真实密钥。
# Java MySQL 模式必填；stub 契约演示不需要这三项。
DB_URL=jdbc:mysql://127.0.0.1:3306/fraud_demo?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=replace-with-least-privilege-demo-user
DB_PASSWORD=replace-with-local-password
MODEL_BASE_URL=http://127.0.0.1:8000
VITE_API_TARGET=http://127.0.0.1:8080
# 虚构演示账号的覆盖项；生产禁用默认密码，绝不提交真实口令。
APP_DEMO_ANALYST_PASSWORD=replace-with-demo-only-password
APP_DEMO_REVIEWER_PASSWORD=replace-with-demo-only-password
APP_DEMO_ADMIN_PASSWORD=replace-with-demo-only-password
